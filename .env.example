# --- Cloudflare R2 (temporary public hosting so Meta can fetch each video)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clipbot-reels

# --- AI hook titles/captions
ANTHROPIC_API_KEY=

# --- Phone alerts (ntfy.sh topic name; pick something long and unguessable)
NTFY_TOPIC=
