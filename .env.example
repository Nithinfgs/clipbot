# Copy to .env (gitignored). Never paste these values into chat.

# --- Instagram (Instagram API with Instagram Login), one pair per account
IG_USER_ID_1=
IG_TOKEN_1=
IG_USER_ID_2=
IG_TOKEN_2=
IG_USER_ID_3=
IG_TOKEN_3=
IG_USER_ID_4=
IG_TOKEN_4=
IG_USER_ID_5=
